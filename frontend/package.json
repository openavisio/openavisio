{
  "name": "openavisio-frontend",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "e2e": "playwright test",
    "api-types": "cd ../backend && uv run python ../scripts/openapi.py > /tmp/openapi.json && cd ../frontend && openapi-typescript /tmp/openapi.json --default-non-nullable false -o src/lib/api-schema.ts"
  },
  "dependencies": {
