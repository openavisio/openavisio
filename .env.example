# Required
APP_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
POSTGRES_USER=openavisio
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# One-time token required by the first-run setup wizard (POST /organization/init).
# setup.sh generates and prints this. Enforced when ENVIRONMENT != development.
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Shared secret for backend→aiservice calls (#46). Same value for backend + aiservice.
AISERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Database (auto-built from POSTGRES_* in docker-compose; set directly for local dev)
# DATABASE_URL=postgresql+asyncpg://openavisio:password@localhost:5432/vaultdb

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Service
AI_BACKEND=mock
# AI_BACKEND=ollama|vllm
# vllm covers any OpenAI-compatible endpoint, your own or a hosted provider's.
# Patient data goes wherever VLLM_URL points: a hosted provider needs a DPA.

# Ollama (leave empty to disable)
OLLAMA_URL=
# Optional: pin vision OCR / embeddings to their own Ollama instance (own GPU),
# so a big LLM never has to share VRAM with them. Both fall back to OLLAMA_URL.
# The URL pool is round-robin, so do NOT put several role-specific hosts in
# OLLAMA_URL - split them here instead.
OLLAMA_VISION_URL=
OLLAMA_EMBED_URL=
OLLAMA_MODEL=qwen3.6:27b-mtp-q4_K_M
OLLAMA_MODELS=qwen3.6:27b-mtp-q4_K_M,glm-ocr:Q8_0,qwen3-embedding:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
OLLAMA_CLASSIFY_MODEL=qwen3.6:27b-mtp-q4_K_M
OLLAMA_EXTRACT_MODEL=qwen3.6:27b-mtp-q4_K_M
OLLAMA_VISION_MODEL=glm-ocr:Q8_0
OLLAMA_CHAT_MODEL=qwen3.6:27b-mtp-q4_K_M

# vLLM / any OpenAI-compatible endpoint (optional)
VLLM_URL=
VLLM_MODEL=
# Bearer token, if the endpoint asks for one (a hosted provider, or a vLLM of
# your own started with --api-key).
VLLM_API_KEY=
# Vision OCR at the same (or another) OpenAI-compatible endpoint. Leave empty to
# keep OCR on an Ollama; OLLAMA_VISION_URL always wins if both are set.
VLLM_VISION_URL=
VLLM_VISION_MODEL=
# Embeddings at an OpenAI-compatible endpoint. Vectors wider than 768 are
# truncated client-side when the provider rejects the `dimensions` parameter.
VLLM_EMBED_URL=
VLLM_EMBED_MODEL=

# Document processing
DOCUMENT_STORAGE_PATH=./data/documents

# Background jobs
EMBEDDING_SCHEDULER_CRON=*/15 * * * *
EMBEDDING_SCHEDULER_BATCH_SIZE=50

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000

# Licensing (optional — leave empty to use the embedded dev key for testing)
# In production, set this to the RSA-2048 public key (PEM) provided by OpenAvisio
# LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Production only
DOMAIN=yourdomain.com

# Frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Passkeys / WebAuthn (must match the domain your frontend is served from)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OpenAvisio
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Backups (deploy/backup, ADR-022 / ADR-031) ---
# age PUBLIC key. Backups are encrypted to it; the private key must live
# OUT-OF-BAND (password manager / paper) and never on the server. Losing it
# makes every backup unreadable. Generate: age-keygen
AGE_PUBKEY=
# Host directory the dumps land in. Sync it OFF this machine — a backup on the
# same disk as the database is not a backup.
BACKUP_DIR=/opt/openavisio-backups
BACKUP_HOUR=3
RETENTION_CLINICAL_DAYS=90
# Keep short: this is what lets crypto-shredding reach backups (ADR-031).
RETENTION_KEYSTORE_DAYS=7

# Shows the "preview — not ready for production use" banner. true on test instances.
PREVIEW_BANNER=false

# --- Mail (optional) ---
# SMTP is normally configured in the admin UI and stored in the database. These
# are a FALLBACK, used only while no SMTP settings exist there — a hosted
# installation is handed to its owner ready to send, without anyone writing into
# their database. Values set in the admin UI always win.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Extra recipient for pipeline-failure alerts, on top of the instance admins.
# For a hosted installation: the operator, who has no account here. The mail
# carries counts and error strings only, never a patient reference.
OPS_ALERT_EMAIL=
